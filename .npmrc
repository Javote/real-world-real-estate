strict-peer-dependencies=false

# `auto-install-peers=false` a propósito (D-052). Con `true`, pnpm instalaba
# también los peers OPCIONALES, y `db0` —que viene con Nitro y que nada de este
# repo usa— declara `drizzle-orm` como peer opcional. Eso arrastraba en cascada
# drizzle-orm → prisma → @prisma/engines: dos ORMs que D-048 y D-049 habían
# sacado del proyecto, instalados en cada build de Render.
auto-install-peers=false
