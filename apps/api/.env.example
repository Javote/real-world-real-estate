# SQLite en desarrollo (D-016, D-048). Ruta relativa a apps/api/ (libSQL
# vía @libsql/client, no Prisma). Contra Turso en prod: libsql://...
DATABASE_URL="file:./.data/dev.db"

# Solo para Turso (D-038): token de auth de la base remota. Vacío/ausente en
# local, donde un `file:` no lo necesita.
DATABASE_AUTH_TOKEN=

# Secreto de firma de JWT. OBLIGATORIO y sin valor por defecto (D-042): si falta o queda
# vacío, la API no arranca. Generá el tuyo y pegalo acá:  openssl rand -hex 32
JWT_SECRET=

# 8787 es el puerto de la API en dev (el 3000 es del front — ver CLAUDE.md §Comandos)
PORT=8787

# Almacenamiento local de evidencia (D-016; transición a S3 = D-011)
UPLOAD_DIR="./uploads"
# 50, no 10: un PDF de varias decenas de páginas sin optimizar, con fotos de
# obra en alta resolución, pasa cómodo los 10 MB del default original. R2
# acepta objetos de hasta 5 GiB por PUT simple (ver storage.ts), así que el
# techo real es una decisión de producto, no una limitación del storage.
# Si tocás este número, actualizá también `maxSizeMb` en el FileDropzone del
# developer (apps/web/src/routes/developer.project.$projectId.upload.tsx) —
# son dos validaciones independientes y el front no lee esta variable.
MAX_FILE_SIZE_MB=50

# Intentos de login por IP cada 15 min. Existe porque cerrar el oráculo de
# tiempos hizo que TODO intento cueste un bcrypt: sin límite, un spray de emails
# inventados voltea la instancia (D-045). Un valor inválido cae al default (20).
LOGIN_RATE_LIMIT_MAX=20

# Límite sobre GET /public/dossier/:shareToken (SPEC-211), la otra ruta sin
# sesión. Más laxo que el del login: el caso legítimo es un escribano
# reabriendo el link, no un intento de adivinar una credencial. Un valor
# inválido cae al default (60).
DOSSIER_RATE_LIMIT_MAX=60

# Cuántos proxies hay delante de la API — de ahí sale la IP que usa el limiter.
# 0 en local. AL DESPLEGAR HAY QUE SETEARLO (Render: 1): con 0 detrás del proxy,
# todos los clientes comparten balde y la app se vuelve inusable (D-045).
TRUST_PROXY_HOPS=0

# Passwords del seed de demo. Vacías en local: contra un SQLite en disco el seed
# usa los defaults que documenta el README, porque ahí no hay nada que proteger.
# Contra CUALQUIER otra base (Turso, Postgres) el seed **se niega a correr** sin
# esto: sus credenciales están publicadas en el repo y sembrarlas en una
# instancia desplegada deja una cuenta admin de credenciales conocidas (D-047).
#   openssl rand -base64 24
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ── Anclaje en Cardano (D-014, SPEC-013) ───────────────────────────────────

# `simulated` (default) usa el adaptador simulado, que rechaza lo mismo que el
# validador pero sin red ni claves. `real` construye transacciones de verdad y
# hoy exige que quien arme el puerto le pase la instancia de Lucid — ver
# packages/cardano. Un valor inválido revienta al arrancar, no en el primer
# anclaje (D-042).
ANCHOR_MODE=simulated

# SIEMPRE Preprod (D-013): mainnet está fuera del alcance de M3. Todavía no la
# lee nadie; queda declarada para que el día del adaptador contra Preprod no
# haya que tocar infraestructura.
CARDANO_NETWORK=Preprod

# ── Almacenamiento de evidencia (D-011) ────────────────────────────────────

# `disk` guarda en UPLOAD_DIR. `s3` habla con cualquier S3: MinIO en local
# (compose.dev.yml), Cloudflare R2 en prod. Es el MISMO código — cambian estas
# variables, no el driver. Con `s3` y configuración incompleta, el proceso no
# arranca (D-042).
STORAGE_DRIVER=disk

# Solo con STORAGE_DRIVER=s3. Los valores de abajo son los del MinIO local:
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=propnexus-dev
# S3_ACCESS_KEY_ID=propnexus
# S3_SECRET_ACCESS_KEY=propnexus-dev-only
# S3_REGION=us-east-1
# Path-style es lo que necesita MinIO; R2 lo tolera. Default: true.
# S3_FORCE_PATH_STYLE=true
# Crear el bucket si falta. En MinIO sí; en R2 el bucket se crea afuera.
# S3_CREATE_BUCKET=true

# ── Anclaje real en Preprod ─────────────────────────────────────────────────
# El factory YA las lee (`packages/cardano/src/factory.ts`). Siguen comentadas
# porque solo hacen falta con ANCHOR_MODE=real: con `simulated` —el default— no
# se consultan. Contra el devnet local (compose.dev.yml) tampoco: ahí el
# provider es Kupmios y la wallet se fondea con el faucet del devkit.
#
# ⚠ Si ponés ANCHOR_MODE=real, estas dos son OBLIGATORIAS. Su ausencia no impide
# arrancar, pero deja el anclaje inhabilitado y lo dice en el log (D-075).
#
# `SERVICE_WALLET_PRIVATE_KEY` es la CLAVE DE PAGO en bech32, no una seed de 24
# palabras (D-078): una seed deriva el árbol HD entero y el servicio solo
# necesita firmar con una clave. La genera `pnpm --filter @plataforma/cardano
# wallet:new`, que la escribe a un archivo con permisos 600 y no la imprime.
#
# ⚠ NO SE PUEDE ROTAR sin migrar todos los hilos ya anclados: el admin del
# validador es el hash de esta clave. Elegila para quedarse.
# ANCHOR_MODE=real
# BLOCKFROST_API_KEY=preprod_xxx
# SERVICE_WALLET_PRIVATE_KEY=ed25519_sk1...
# CARDANO_NETWORK=Preprod
# EXPLORER_BASE=https://preprod.cardanoscan.io

# ── Observabilidad (opcional, M3 §4) ────────────────────────────────────────
# `instrumentation.ts` (precargado con `node --require`, ver package.json
# "dev"/"start") queda apagado sin estas dos — no rompe nada, solo no manda
# nada. `pnpm dev` funciona igual sin haber creado ninguna cuenta.
#
# DSN del proyecto en sentry.io (free tier: 5.000 eventos/mes).
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
#
# Endpoint OTLP del stack de Grafana Cloud (free tier). Formato típico:
# https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-xx-xxx.grafana.net/otlp
#
# Basic Auth de Grafana Cloud: "Authorization=Basic <base64(instanceID:apiKey)>".
# Lo arma el propio dashboard de Grafana Cloud al crear el stack — se copia
# tal cual, no se genera acá.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20xxxxx
