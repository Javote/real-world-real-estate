# Variables de `apps/web`. Las dos son de BUILD TIME, no de runtime: `ports.ts`
# las lee al construir y Nitro las hornea en el bundle. Cambiarlas exige
# rebuild, no restart.
#
# No hace falta tenerlo: sin este archivo son 3000/8787. Copialo solo si
# necesitás otros puertos (por ejemplo, para correr dos copias a la vez).

WEB_PORT=3000

# Origen de la API al que Nitro proxea `/api/**` y `/health`. En el deploy es
# la URL pública de la API — ver specs/RUNBOOK-deploy.md.
API_ORIGIN=http://localhost:8787

# Plantilla del explorador de Cardano (M2-D5 §3): el cliente arma
# `$EXPLORER_BASE/transaction/:txid`. Default: Preprod (D-013).
VITE_EXPLORER_BASE=https://preprod.cardanoscan.io

# ── Observabilidad del cliente (opcional, M3 §4/§5) ─────────────────────────
# `lib/observability.ts` queda apagado sin estas dos — `pnpm dev` funciona
# igual sin haber creado ninguna cuenta.
#
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
#
# PostHog acá es solo web vitals (Core Web Vitals), sin autocapture ni session
# recording — ver el comentario de observability.ts sobre por qué (regla 2).
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
