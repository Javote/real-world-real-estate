{
  "name": "@plataforma/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Contrato único API↔web: schemas Zod y los tipos que ambos importan (D-012, regla 6)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract:min": "tsx scripts/contrato-min.ts"
  },
  "dependencies": {
    "@orpc/client": "1.15.2",
    "@orpc/contract": "1.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "^4.19.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evidence-rules": {
      "types": "./src/evidence-rules.ts",
      "default": "./src/evidence-rules.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./contract.min.json": "./src/contract/contract.min.json"
  }
}
