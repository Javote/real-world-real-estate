{
  "dossier": {
    "notary": {
      "kpis": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "notary"
              ],
              "acceso": {
                "scopeEnQuery": "Dossier.signedById = usuario"
              }
            }
          },
          "route": {
            "method": "GET",
            "path": "/notary/kpis"
          }
        }
      },
      "pendientes": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "notary"
              ],
              "acceso": "soloRol"
            }
          },
          "route": {
            "method": "GET",
            "path": "/notary/dossiers/pending"
          }
        }
      },
      "porId": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "notary"
              ],
              "acceso": "soloRol"
            }
          },
          "route": {
            "method": "GET",
            "path": "/notary/dossiers/{id}"
          }
        }
      },
      "firmar": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "notary"
              ],
              "acceso": "soloRol"
            }
          },
          "route": {
            "method": "POST",
            "path": "/notary/dossiers/{id}/sign",
            "outputStructure": "detailed",
            "successStatus": 201
          }
        }
      },
      "rechazar": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "notary"
              ],
              "acceso": "soloRol"
            }
          },
          "route": {
            "method": "POST",
            "path": "/notary/dossiers/{id}/reject"
          }
        }
      },
      "firmas": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "notary"
              ],
              "acceso": {
                "scopeEnQuery": "Dossier.signedById = usuario"
              }
            }
          },
          "route": {
            "method": "GET",
            "path": "/notary/signatures"
          }
        }
      }
    },
    "investor": {
      "dossier": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "buyer"
              ],
              "acceso": {
                "dueño": {
                  "via": "Unit",
                  "param": "id"
                }
              }
            }
          },
          "route": {
            "method": "GET",
            "path": "/investor/units/{id}/dossier"
          }
        }
      },
      "exportar": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "buyer"
              ],
              "acceso": {
                "dueño": {
                  "via": "Unit",
                  "param": "id"
                }
              }
            }
          },
          "route": {
            "method": "GET",
            "path": "/investor/units/{id}/dossier/export.pdf",
            "outputStructure": "detailed"
          }
        }
      },
      "compartir": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "roles": [
                "admin",
                "buyer"
              ],
              "acceso": {
                "dueño": {
                  "via": "Unit",
                  "param": "id"
                }
              }
            }
          },
          "route": {
            "method": "POST",
            "path": "/investor/units/{id}/dossier/share",
            "successStatus": 201
          }
        }
      }
    },
    "publico": {
      "dossier": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "guard": {
              "sinSesion": true
            }
          },
          "route": {
            "method": "GET",
            "path": "/public/dossier/{shareToken}"
          }
        }
      }
    }
  },
  "metricas": {
    "completitud": {
      "~orpc": {
        "errorMap": {},
        "meta": {
          "guard": {
            "roles": [
              "admin"
            ],
            "acceso": "soloRol"
          }
        },
        "route": {
          "method": "GET",
          "path": "/admin/document-completeness"
        }
      }
    }
